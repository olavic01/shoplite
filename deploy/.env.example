# Copy to .env on the app server. Never commit the real .env.
POSTGRES_PASSWORD=change-this-db-password
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-chars
# Private IP of this server, used by Kafka for clients outside the docker network (optional)
IMAGE_TAG=latest
# Latency drill: set to e.g. 800 to slow down product DB reads, then `docker compose up -d product-service`
SLOW_MS=0
# Private IP of the observability server (Promtail pushes logs here)
LOKI_HOST=10.0.2.20
